#!/usr/bin/env bash
set -e

ulimit -n 65535 2>/dev/null || ulimit -n 4096 2>/dev/null || true

PYTHON_BIN="$(command -v python3)"
if [ -z "$PYTHON_BIN" ]; then
    echo "Python 3 was not found. Activate the project's virtual environment first."
    exit 1
fi

# Keep the PyTgCalls/Kurigram integration on the compatible pinned version.
"$PYTHON_BIN" -m pip install --disable-pip-version-check --no-input --upgrade "kurigram==2.2.27"

# Fail early with a clear message if the required Telegram raw type is unavailable.
"$PYTHON_BIN" -c "from pyrogram.raw.types import InputGroupCallSlug" || {
    echo "Kurigram installation is missing InputGroupCallSlug. Check the active virtual environment."
    exit 1
}

exec "$PYTHON_BIN" -m nexo
