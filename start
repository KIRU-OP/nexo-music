#!/usr/bin/env bash
set -e

ulimit -n 65535 2>/dev/null || ulimit -n 4096 2>/dev/null || true

PYTHON_BIN="$(command -v python3)"
if [ -z "$PYTHON_BIN" ]; then
    echo "Python 3 was not found. Activate the project's virtual environment first."
    exit 1
fi

# Install both pinned Telegram client distributions.
"$PYTHON_BIN" -m pip install --disable-pip-version-check --no-input --upgrade --force-reinstall --no-cache-dir "Pyrogram==2.2.27" "Kirugram==2.2.27"

# Verify Kirugram imports and the Pyrogram client expected by PyTgCalls.
"$PYTHON_BIN" -c "import kirugram, pyrogram; from kirugram import Client as KirugramClient; from pyrogram.raw.types import InputGroupCallSlug; from pytgcalls import PyTgCalls; from pytgcalls.mtproto.bridged_client import BridgedClient; client = pyrogram.Client('pyrogram-compat-check', 12345, '0' * 32); assert BridgedClient.package_name(client) == 'pyrogram'; PyTgCalls(client); assert KirugramClient is kirugram.Client; assert InputGroupCallSlug is not None; print('Pyrogram/Kirugram 2.2.27 compatibility OK')" || {
    echo "Pyrogram/Kirugram compatibility check failed. Verify Pyrogram==2.2.27, Kirugram==2.2.27 and py-tgcalls==2.3.3."
    exit 1
}

exec "$PYTHON_BIN" -m nexo
