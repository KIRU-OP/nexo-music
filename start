#!/usr/bin/env bash
set -e

ulimit -n 65535 2>/dev/null || ulimit -n 4096 2>/dev/null || true

PYTHON_BIN="$(command -v python3)"
if [ -z "$PYTHON_BIN" ]; then
    echo "Python 3 was not found. Activate the project's virtual environment first."
    exit 1
fi

# Install the released Kirugram 2.2.27 tag from the project's own repository.
KIRUGRAM_SOURCE="Kirugram @ git+https://github.com/KIRU-OP/Kirugram.git@2.2.27"
"$PYTHON_BIN" -m pip install --disable-pip-version-check --no-input --upgrade --force-reinstall --no-cache-dir "$KIRUGRAM_SOURCE"

# Keep startup diagnostics specific: don't depend on PyTgCalls' internal Pyrogram label.
"$PYTHON_BIN" - <<'PY'
import kirugram
from kirugram import Client
from kirugram.raw.types import InputGroupCallSlug
from kirugram_pytgcalls_compat import install_pytgcalls_compat

install_pytgcalls_compat()

from pytgcalls import PyTgCalls

print(f"Loaded Kirugram {getattr(kirugram, '__version__', 'unknown')} from {kirugram.__file__}")
if getattr(kirugram, "__version__", None) != "2.2.27":
    raise RuntimeError(f"Expected Kirugram 2.2.27, got {getattr(kirugram, '__version__', None)!r}")

if InputGroupCallSlug is None:
    raise RuntimeError("Kirugram raw type InputGroupCallSlug is unavailable")

client = Client("kirugram-compat-check", 12345, "0" * 32)
calls = PyTgCalls(client)
if calls is None:
    raise RuntimeError("PyTgCalls did not initialize with the Kirugram client")

print("Kirugram 2.2.27 and PyTgCalls compatibility OK")
PY

exec "$PYTHON_BIN" -m nexo
