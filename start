#!/usr/bin/env bash
set -e

ulimit -n 65535 2>/dev/null || ulimit -n 4096 2>/dev/null || true

PYTHON_BIN="$(command -v python3)"
if [ -z "$PYTHON_BIN" ]; then
    echo "Python 3 was not found. Activate the project's virtual environment first."
    exit 1
fi

# Install the pinned Kurigram 2.2.27 distribution.
"$PYTHON_BIN" -m pip install --disable-pip-version-check --no-input --upgrade --force-reinstall --no-cache-dir "kurigram==2.2.27"

# Fail early with a clear message if the required Telegram raw type is unavailable.
"$PYTHON_BIN" -c "from pyrogram.raw.types import InputGroupCallSlug" || {
    echo "Kurigram installation is missing InputGroupCallSlug. Check the active virtual environment."
    exit 1
}

# Verify that the installed Kurigram client is accepted by PyTgCalls.
"$PYTHON_BIN" -c "import pyrogram; from pytgcalls import PyTgCalls; from pytgcalls.mtproto.bridged_client import BridgedClient; client = pyrogram.Client('kurigram-compat-check', 12345, '0' * 32); assert BridgedClient.package_name(client) == 'pyrogram', BridgedClient.package_name(client); PyTgCalls(client); print('Kurigram/PyTgCalls compatibility OK')" || {
    echo "Kurigram/PyTgCalls compatibility check failed. Verify that this virtual environment has the kurigram==2.2.27 and py-tgcalls==2.3.3."
    exit 1
}

exec "$PYTHON_BIN" -m nexo
