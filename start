#!/usr/bin/env bash
set -e

ulimit -n 65535 2>/dev/null || ulimit -n 4096 2>/dev/null || true

PYTHON_BIN="$(command -v python3)"
if [ -z "$PYTHON_BIN" ]; then
    echo "Python 3 was not found. Activate the project's virtual environment first."
    exit 1
fi

# Install the released Kirugram 2.2.27 tag from the project's own repository.
KIRUGRAM_SOURCE="Kirugram @ git+https://github.com/KIRU-OP/Kirugram.git@2.2.27"
"$PYTHON_BIN" -m pip install --disable-pip-version-check --no-input --upgrade --force-reinstall --no-cache-dir "$KIRUGRAM_SOURCE"

# Verify the imported package version and PyTgCalls compatibility bridge.
"$PYTHON_BIN" -c "import kirugram; from importlib.metadata import version; from kirugram import Client as KirugramClient; from kirugram.raw.types import InputGroupCallSlug; from pytgcalls import PyTgCalls; from pytgcalls.mtproto.bridged_client import BridgedClient; assert kirugram.__version__ == '2.2.27', kirugram.__version__; assert version('Kirugram') == '2.2.27'; client = kirugram.Client('kirugram-compat-check', 12345, '0' * 32); assert BridgedClient.package_name(client) == 'pyrogram'; PyTgCalls(client); assert KirugramClient is kirugram.Client; assert InputGroupCallSlug is not None; print('Kirugram 2.2.27/PyTgCalls compatibility OK')" || {
    echo "Kirugram 2.2.27 install/version/compatibility check failed."
    exit 1
}

exec "$PYTHON_BIN" -m nexo
